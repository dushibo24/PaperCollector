# 复制为 .env。该文件已被 gitignore；不要提交真实密钥。
# Claude Code CLI 使用的 Anthropic 兼容端点，例如 https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# 可选：默认模型；留空时由 Claude CLI 决定。
ANTHROPIC_MODEL=
SERVERCHAN_SENDKEY=
READING_NOTES_BASE_URL=
WECOM_WEBHOOK_KEY=
SEMANTIC_SCHOLAR_API_KEY=
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
# 可选：访问令牌优先于账号密码，适合启用了 MFA 的定时任务。
OPENREVIEW_ACCESS_TOKEN=
IEEE_XPLORE_API_KEY=
ELSEVIER_API_KEY=
BAIDUPAN_COOKIE=
# pdf2zh 的 OpenAI 兼容翻译接口。DeepSeek 示例：
# OPENAILIKED_BASE_URL=https://api.deepseek.com/v1
# OPENAILIKED_API_KEY 可留空，并在 config.toml 写 "${ANTHROPIC_AUTH_TOKEN}" 复用上面的 Key。
# OPENAILIKED_MODEL=deepseek-flash
OPENAILIKED_BASE_URL=
OPENAILIKED_API_KEY=
OPENAILIKED_MODEL=
